# Copy to .env.local for development. Never commit real values.
# Without the Sanity variables the site runs on the seed content in src/content (dev only).
# On Vercel (preview + production) the server refuses to start if a required variable is missing.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (content + leads) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Private dataset for leads (used by the server and by the Studio "פניות" workspace)
SANITY_LEADS_DATASET=leads
NEXT_PUBLIC_SANITY_LEADS_DATASET=leads
# Viewer token: draft previews in Presentation. Server only.
SANITY_READ_TOKEN=
# Editor token: writes leads (and runs the seed script). Server only. Required on Vercel.
SANITY_WRITE_TOKEN=
# Shared secret of the "revalidate" webhook, at least 32 characters. Required on Vercel.
SANITY_WEBHOOK_SECRET=

# --- Email (Resend). Required on Vercel. ---
RESEND_API_KEY=
EMAIL_FROM="עומק <hello@your-domain.co.il>"
OWNER_EMAIL=wkhn091@gmail.com

# --- Bot protection (Cloudflare Turnstile). Required on Vercel. ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis). Required on Vercel. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing visitor IPs, at least 32 random characters. Required on Vercel.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_IP_SALT=

# --- Analytics (load only after cookie consent). Optional. ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
